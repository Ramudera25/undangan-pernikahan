---
import { milestones } from '../data/wedding';
import SulurDivider from './ornaments/SulurDivider.astro';
---

<section id="kisah" class="py-16 px-4 max-w-3xl mx-auto relative scroll-mt-24">
  <div class="text-center mb-14" data-reveal>
    <p class="text-[10px] text-wedding-600 tracking-[0.25em] uppercase font-semibold">Kisah Kami</p>
    <h2 class="font-serif text-3xl sm:text-4xl text-ink mt-1 mb-3">Perjalanan Kasih</h2>
    <p class="text-sm text-ink-soft max-w-sm mx-auto leading-relaxed">
      Setiap pertemuan adalah takdir, dan setiap langkah adalah bagian dari cerita indah yang Allah
      tuliskan untuk kami.
    </p>
    <SulurDivider class="w-48 h-6 mx-auto mt-5 text-wedding-400" />
  </div>

  <div class="relative">
    <!-- Garis tengah linimasa -->
    <div
      class="absolute left-7 md:left-1/2 -translate-x-1/2 top-0 bottom-0 w-px bg-gradient-to-b from-transparent via-wedding-300 to-transparent"
    ></div>

    <ol class="space-y-10">
      {milestones.map((m, i) => (
        <li class="relative pl-20 md:pl-0">
          <!-- Simpul ikon pada garis -->
          <div
            class="absolute left-7 md:left-1/2 -translate-x-1/2 top-1 z-10 flex items-center justify-center w-11 h-11 rounded-full bg-wedding-50 border border-wedding-300 shadow-md"
          >
            {m.icon === 'sparkles' && (
              <svg class="w-5 h-5 text-wedding-600" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 3l1.8 4.7L18.5 9l-4.7 1.8L12 15.5l-1.8-4.7L5.5 9l4.7-1.3L12 3zM18 15l.9 2.4L21 18l-2.1.9L18 21l-.9-2.1L15 18l2.1-.6L18 15z"
                ></path>
              </svg>
            )}
            {m.icon === 'chat' && (
              <svg class="w-5 h-5 text-wedding-600" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M8 10h8M8 14h5M21 12a8 8 0 01-11.6 7.1L4 21l1.6-3.6A8 8 0 1121 12z"
                ></path>
              </svg>
            )}
            {m.icon === 'heart' && (
              <svg class="w-5 h-5 text-wedding-600" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 21S4 15.5 4 9.5A4.5 4.5 0 0112 6.6 4.5 4.5 0 0120 9.5c0 6-8 11.5-8 11.5z"
                ></path>
              </svg>
            )}
            {m.icon === 'rings' && (
              <svg class="w-5 h-5 text-wedding-600" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
                <circle cx="9" cy="14" r="5.5"></circle>
                <circle cx="15" cy="14" r="5.5"></circle>
                <path stroke-linecap="round" d="M12 3l2 3h-4l2-3z"></path>
              </svg>
            )}
          </div>

          <!-- Kartu konten: kiri/kanan berselang di desktop -->
          <div
            class:list={[
              'surface w-full rounded-2xl p-6 backdrop-blur-md hover:border-wedding-400 transition-all md:w-[calc(50%-2.5rem)]',
              i % 2 === 0 ? 'md:mr-auto md:pr-8 md:text-right' : 'md:ml-auto md:pl-8 md:text-left',
            ]}
            data-reveal
            data-reveal-delay={String(i * 100)}
          >
            <span
              class="inline-block text-[10px] font-semibold tracking-[0.2em] text-wedding-600 uppercase bg-wedding-200 px-3 py-1 rounded-full"
            >
              {m.year}
            </span>
            <h3 class="font-serif text-xl text-ink mt-3">{m.title}</h3>
            <p class="text-sm text-ink-soft leading-relaxed mt-2">{m.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
