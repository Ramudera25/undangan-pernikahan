---
import { milestones } from '../data/wedding';
import SulurDivider from './ornaments/SulurDivider.astro';
import BungaHias from './ornaments/BungaHias.astro';

const makeUrl = (p: string) => `${import.meta.env.BASE_URL}/${p}`.replace(/(?<!:)\/\/+/g, '/');
---

<section id="kisah" class="py-16 px-4 max-w-3xl mx-auto relative scroll-mt-24">
  <div class="text-center mb-14" data-reveal>
    <p class="text-[10px] text-wedding-600 tracking-[0.25em] uppercase font-semibold">Kisah Kami</p>
    <h2 class="font-serif text-3xl sm:text-4xl text-ink mt-1 mb-3">Perjalanan Kasih</h2>
    <p class="text-sm text-ink-soft max-w-sm mx-auto leading-relaxed">
      Setiap pertemuan adalah takdir, dan setiap langkah adalah bagian dari cerita indah yang Allah
      tuliskan untuk kami.
    </p>
    <SulurDivider class="w-48 h-6 mx-auto mt-5 text-wedding-400" />
    <BungaHias class="w-24 h-11 mx-auto text-wedding-400/70 mt-3" />
  </div>

  <div class="relative">
    <!-- Garis tengah linimasa: gradient emas -->
    <div
      class="absolute left-7 md:left-1/2 -translate-x-1/2 top-0 bottom-0 w-0.5 bg-gradient-to-b from-transparent via-[#d4af37] to-transparent"
    ></div>

    <ol class="space-y-10">
      {milestones.map((m, i) => (
        <li class="relative pl-20 md:pl-0">
          <!-- Simpul pada garis: lingkaran dengan ring emas + dot emas -->
          <div
            class="timeline-node absolute left-7 md:left-1/2 -translate-x-1/2 top-1 z-10 flex items-center justify-center w-11 h-11 rounded-full"
            data-reveal
            data-reveal-delay={String(i * 100)}
            aria-hidden="true"
          >
            <span class="timeline-dot block w-3.5 h-3.5 rounded-full"></span>
          </div>

          <!-- Kartu konten: kiri/kanan berselang di desktop -->
          <div
            class:list={[
              'surface w-full rounded-2xl overflow-hidden backdrop-blur-md hover:border-wedding-400 transition-all md:w-[calc(50%-2.5rem)]',
              i % 2 === 0 ? 'md:mr-auto' : 'md:ml-auto',
            ]}
            data-reveal
            data-reveal-delay={String(i * 100)}
          >
            <div class="overflow-hidden">
              <img
                src={makeUrl(m.photo)}
                alt={m.photoAlt}
                loading="lazy"
                class="w-full h-56 object-cover object-top hover:scale-105 transition-transform duration-700"
              />
            </div>
            <div class:list={['p-6', i % 2 === 0 ? 'md:pr-8 md:text-right' : 'md:pl-8 md:text-left']}>
              <span
                class="inline-block text-[10px] font-semibold tracking-[0.2em] uppercase px-3 py-1 rounded-full border border-[#d4af37]/60 bg-gradient-to-r from-[#faf0d2] to-[#f3dd9a] text-[#8a6d1c]"
              >
                {m.year}
              </span>
              <h3 class="font-serif text-xl text-ink mt-3">{m.title}</h3>
              <p class="text-sm text-ink-soft leading-relaxed mt-2">{m.text}</p>
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  /* ---------- Simpul linimasa emas ---------- */
  .timeline-node {
    background: #fffdf7;
    box-shadow:
      0 0 0 2px #d4af37,
      0 0 0 5px rgba(212, 175, 55, 0.22),
      0 6px 14px -6px rgba(120, 90, 30, 0.4);
  }
  .timeline-dot {
    background: radial-gradient(circle at 35% 30%, #f4dc8a, #d4af37 60%, #a67c1a);
    box-shadow: 0 0 6px rgba(212, 175, 55, 0.8);
  }
  /* Pulse halus sekali saat simpul ikut reveal bersama kartu. */
  .timeline-node.reveal-visible {
    animation: timeline-pulse 1.5s ease-out;
  }
  @keyframes timeline-pulse {
    0% {
      box-shadow:
        0 0 0 2px #d4af37,
        0 0 0 5px rgba(212, 175, 55, 0.22),
        0 0 0 0 rgba(212, 175, 55, 0.5);
    }
    70% {
      box-shadow:
        0 0 0 2px #d4af37,
        0 0 0 5px rgba(212, 175, 55, 0.22),
        0 0 0 16px rgba(212, 175, 55, 0);
    }
    100% {
      box-shadow:
        0 0 0 2px #d4af37,
        0 0 0 5px rgba(212, 175, 55, 0.22),
        0 6px 14px -6px rgba(120, 90, 30, 0.4);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .timeline-node.reveal-visible {
      animation: none;
    }
  }
</style>
