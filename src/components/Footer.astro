---
import { couple, countdownEvent, scheduleConfirmed } from '../data/wedding';
import { formatEventDate } from '../utils/schedule';
import Gunungan from './ornaments/Gunungan.astro';
import SulurDivider from './ornaments/SulurDivider.astro';

const eventDate = countdownEvent.startISO ? formatEventDate(countdownEvent.startISO) : '';
const year = new Date().getFullYear();
---

<section class="relative text-center py-20 px-4 overflow-hidden bg-wedding-100/60">
  <div class="orn-kawung absolute inset-0 opacity-40 pointer-events-none"></div>
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[420px] h-[420px] bg-wedding-200/70 rounded-full blur-3xl pointer-events-none"
  ></div>
  <Gunungan class="absolute -bottom-4 left-1/2 -translate-x-1/2 w-40 h-56 text-wedding-300/50 pointer-events-none" />

  <div class="relative z-10 max-w-xl mx-auto">
    <SulurDivider class="w-48 h-6 mx-auto text-wedding-500 mb-6" data-reveal />

    <blockquote
      class="font-serif text-xl sm:text-2xl text-ink leading-relaxed"
      data-reveal
      data-reveal-delay="80"
    >
      "Dan di antara tanda-tanda kekuasaan-Nya ialah Dia menciptakan untukmu pasangan hidup dari
      jenismu sendiri, supaya kamu merasa tenteram kepadanya."
    </blockquote>
    <p class="text-sm text-ink-soft mt-4 italic" data-reveal data-reveal-delay="160">Qs. Ar-Rum : 21</p>

    <div class="mt-10" data-reveal data-reveal-delay="240">
      <p class="text-sm text-ink-soft leading-relaxed">
        Merupakan suatu kehormatan bagi kami apabila Bapak/Ibu/Saudara/i berkenan hadir untuk
        memberikan doa restu kepada kami.
      </p>
      <p class="font-script text-5xl mt-6 text-wedding-600 leading-none">{couple.shortName}</p>
      {eventDate && (
        <p class="text-[10px] tracking-[0.3em] text-wedding-600 uppercase mt-3 font-semibold">
          {eventDate}{!scheduleConfirmed ? ' (jadwal contoh)' : ''}
        </p>
      )}
      <p class="text-sm text-ink-soft mt-4 leading-relaxed">
        {couple.groom.fullName}<br />&amp;<br />
        {couple.bride.fullName}
      </p>
    </div>
  </div>
</section>

<footer class="bg-wedding-800 text-center py-8 px-4">
  <p class="text-[11px] text-wedding-200 tracking-widest uppercase">
    Dibuat dengan <span class="text-wedding-200">&hearts;</span> untuk hari bahagia kami
  </p>
  <p class="text-[11px] text-wedding-300/70 mt-2">&copy; {year} {couple.shortName}</p>
</footer>
