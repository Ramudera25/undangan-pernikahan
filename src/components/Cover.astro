---
import { couple, countdownEvent } from '../data/wedding';
import { formatEventDate } from '../utils/schedule';
import Gunungan from './ornaments/Gunungan.astro';
import SulurDivider from './ornaments/SulurDivider.astro';
import CornerSulur from './ornaments/CornerSulur.astro';

const makeUrl = (p: string) => `${import.meta.env.BASE_URL}/${p}`.replace(/(?<!:)\/\/+/g, '/');
const eventDate = countdownEvent.startISO ? formatEventDate(countdownEvent.startISO) : '';
---

<div
  id="cover-screen"
  class="fixed inset-0 z-50 flex flex-col items-center justify-center text-ink text-center p-6 transition-transform duration-1000 ease-in-out shadow-2xl overflow-hidden"
>
  <!-- Latar foto dengan lapis biru muda -->
  <div class="absolute inset-0 z-0">
    <img
      src={makeUrl('cover.jpg')}
      alt={`Cover undangan pernikahan ${couple.shortName}`}
      width="941"
      height="1672"
      loading="eager"
      class="w-full h-full object-cover scale-105 animate-pulse brightness-105 saturate-[0.85]"
      style="animation-duration: 12s;"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-wedding-50/90 via-wedding-50/72 to-wedding-200/88"></div>
    <div class="orn-kawung absolute inset-0 opacity-40"></div>
  </div>

  <!-- Bingkai ornamen dalam -->
  <div class="absolute inset-4 sm:inset-6 border border-wedding-300/70 rounded-3xl pointer-events-none z-10"></div>
  <div class="absolute inset-5 sm:inset-7 border border-wedding-300/40 rounded-[1.7rem] pointer-events-none z-10"></div>

  <!-- Sulur sudut -->
  <CornerSulur class="absolute top-6 left-6 w-12 h-12 text-wedding-500/70 pointer-events-none z-10" />
  <CornerSulur class="absolute top-6 right-6 w-12 h-12 -scale-x-100 text-wedding-500/70 pointer-events-none z-10" />
  <CornerSulur class="absolute bottom-6 left-6 w-12 h-12 -scale-y-100 text-wedding-500/70 pointer-events-none z-10" />
  <CornerSulur class="absolute bottom-6 right-6 w-12 h-12 -scale-100 text-wedding-500/70 pointer-events-none z-10" />

  <!-- Konten -->
  <div class="relative z-20 flex flex-col items-center max-w-sm w-full">
    <Gunungan class="w-10 h-14 mb-2 text-wedding-600/80 drop-shadow-sm" />

    <p class="text-[10px] tracking-[0.3em] text-wedding-600 uppercase font-semibold mb-1">
      Undangan Pernikahan
    </p>
    <h1 class="font-script text-6xl sm:text-7xl my-1 leading-tight text-ink drop-shadow-sm">
      {couple.shortName}
    </h1>

    <SulurDivider class="w-56 h-7 my-2 text-wedding-500" />

    {eventDate && (
      <p class="text-[11px] tracking-[0.22em] text-ink-soft mb-8 font-light uppercase">
        {eventDate}
      </p>
    )}

    <div class="backdrop-blur-md bg-white/75 border border-wedding-300 p-5 rounded-2xl w-full mb-8 shadow-lg">
      <p class="text-[9px] tracking-[0.22em] text-wedding-600 uppercase font-semibold">
        Kepada Yth. Bapak/Ibu/Saudara/i
      </p>
      <p id="cover-guest-name" class="font-serif text-xl mt-1 text-ink font-medium capitalize">
        Tamu Undangan
      </p>
    </div>

    <button
      id="btn-open"
      class="group relative px-8 py-3.5 bg-wedding-600 text-white font-semibold text-xs tracking-widest rounded-full shadow-xl hover:bg-wedding-700 hover:scale-105 transition-all duration-300 overflow-hidden"
    >
      <span
        class="absolute inset-0 -translate-x-full group-hover:translate-x-full transition-transform duration-700 bg-white/25 skew-x-12"
      ></span>
      <span class="relative flex items-center gap-2">
        BUKA UNDANGAN
        <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"
          ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg
        >
      </span>
    </button>
  </div>
</div>

<script>
  import { getGuestName } from '../utils/getGuestName';

  document.addEventListener('DOMContentLoaded', () => {
    const guestElem = document.getElementById('cover-guest-name');
    if (guestElem) guestElem.textContent = getGuestName();

    const btnOpen = document.getElementById('btn-open');
    const coverScreen = document.getElementById('cover-screen');

    // Kunci scroll saat cover masih menutupi
    document.body.classList.add('overflow-hidden');

    btnOpen?.addEventListener('click', () => {
      coverScreen?.classList.add('-translate-y-full');
      document.body.classList.remove('overflow-hidden');
      window.dispatchEvent(new CustomEvent('play-invitation-music'));
      setTimeout(() => {
        window.dispatchEvent(new CustomEvent('undangan-opened'));
      }, 900);
    });
  });
</script>
