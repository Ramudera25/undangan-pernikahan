---
const makeUrl = (p: string) => `${import.meta.env.BASE_URL}/${p}`.replace(/(?<!:)\/\/+/g, '/');
---
<div id="cover-screen" class="fixed inset-0 z-50 flex flex-col items-center justify-center text-[#EFE7DA] text-center p-6 transition-transform duration-1000 ease-in-out shadow-2xl overflow-hidden">
  
  <!-- Background Image dengan Dark Overlay -->
  <div class="absolute inset-0 z-0">
    <img 
      src={makeUrl('cover.jpg')} 
      alt="Wedding Cover Background" 
      class="w-full h-full object-cover scale-105 animate-pulse"
      style="animation-duration: 10s;"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-[#2B2625]/90 via-[#2B2625]/80 to-[#2B2625]/95"></div>
  </div>

  <!-- Content Overlay -->
  <div class="relative z-10 flex flex-col items-center max-w-sm w-full">
    <div class="w-12 h-12 mb-3 text-[#C5A880] opacity-90 drop-shadow">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
        <path d="M12 2L15 9L22 12L15 15L12 22L9 15L2 12L9 9L12 2Z"/>
      </svg>
    </div>

    <p class="text-[10px] tracking-[0.3em] text-[#C5A880] uppercase font-semibold mb-2">UNDANGAN PERNIKAHAN</p>
    <h1 class="font-serif text-4xl sm:text-5xl my-2 text-transparent bg-clip-text bg-gradient-to-r from-[#EFE7DA] via-[#C5A880] to-[#EFE7DA] font-normal tracking-wide drop-shadow-sm">
      Bayu & Winda
    </h1>
    <p class="text-[11px] tracking-[0.2em] text-gray-300 mb-8 font-light">SABTU &middot; 24 OKTOBER 2026</p>

    <div class="backdrop-blur-md bg-white/10 border border-[#C5A880]/40 p-5 rounded-2xl w-full mb-8 shadow-2xl">
      <p class="text-[9px] tracking-[0.2em] text-[#C5A880] uppercase font-semibold">KEPADA YTH. BAPAK/IBU/SAUDARA/I</p>
      <p id="cover-guest-name" class="font-serif text-lg mt-1 text-[#EFE7DA] font-medium capitalize">Tamu Undangan</p>
    </div>

    <button id="btn-open" class="group relative px-8 py-3.5 bg-gradient-to-r from-[#C5A880] to-[#b5976f] text-[#2B2625] font-semibold text-xs tracking-widest rounded-full shadow-xl hover:scale-105 transition-all duration-300">
      <span class="flex items-center gap-2">
        BUKA UNDANGAN
        <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </span>
    </button>
  </div>
</div>

<script>
  import { getGuestName } from '../utils/getGuestName';

  document.addEventListener('DOMContentLoaded', () => {
    const guestElem = document.getElementById('cover-guest-name');
    if (guestElem) guestElem.textContent = getGuestName();

    const btnOpen = document.getElementById('btn-open');
    const coverScreen = document.getElementById('cover-screen');

    btnOpen?.addEventListener('click', () => {
      coverScreen?.classList.add('-translate-y-full');
      document.body.classList.remove('overflow-hidden');
      window.dispatchEvent(new CustomEvent('play-invitation-music'));
    });
  });
</script>
