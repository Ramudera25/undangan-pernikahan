---
const makeUrl = (p: string) => `${import.meta.env.BASE_URL}/${p}`.replace(/(?<!:)\/\/+/g, '/');
---
<section class="text-center py-16 px-4 max-w-2xl mx-auto relative">
  <p class="text-[10px] text-[#C5A880] tracking-[0.25em] uppercase font-semibold" data-reveal>MEMPELAI</p>
  <h2 class="font-serif text-3xl sm:text-4xl text-[#2B2625] mt-1 mb-3" data-reveal data-reveal-delay="80">Kedua Mempelai</h2>
  <p class="text-xs text-gray-500 max-w-sm mx-auto leading-relaxed mb-12" data-reveal data-reveal-delay="160">Maha Suci Allah yang telah menyatukan kami dalam ikatan suci pernikahan.</p>

  <div class="space-y-8">
    <!-- Groom Card -->
    <div class="p-8 bg-white/70 backdrop-blur-md rounded-3xl shadow-sm border border-[#C5A880]/20 hover:border-[#C5A880]/50 transition-all" data-reveal data-reveal-delay="200">
      <div class="w-24 h-24 mx-auto mb-4 rounded-full p-1 bg-gradient-to-tr from-[#C5A880] to-transparent">
        <img 
          src={makeUrl('groom.jpg')} 
          alt="Bayu Setiawan" 
          class="w-full h-full object-cover rounded-full shadow-md"
        />
      </div>
      <h3 class="font-serif text-2xl font-semibold text-[#2B2625]">Bayu Setiawan, S.T.</h3>
      <p class="text-xs text-gray-500 mt-2 leading-relaxed">Putra Pertama dari Bapak Bambang Setiawan<br/>& Ibu Ratna Sari</p>
    </div>
    
    <span class="font-serif text-3xl text-[#C5A880] italic block my-2" data-reveal data-reveal-delay="280">&amp;</span>

    <!-- Bride Card -->
    <div class="p-8 bg-white/70 backdrop-blur-md rounded-3xl shadow-sm border border-[#C5A880]/20 hover:border-[#C5A880]/50 transition-all" data-reveal data-reveal-delay="320">
      <div class="w-24 h-24 mx-auto mb-4 rounded-full p-1 bg-gradient-to-tr from-[#C5A880] to-transparent">
        <img 
          src={makeUrl('bride.jpg')} 
          alt="Winda Anggraeni" 
          class="w-full h-full object-cover rounded-full shadow-md"
        />
      </div>
      <h3 class="font-serif text-2xl font-semibold text-[#2B2625]">Winda Anggraeni, S.E.</h3>
      <p class="text-xs text-gray-500 mt-2 leading-relaxed">Putri Kedua dari Bapak Hendra Anggraeni<br/>& Ibu Sri Wahyuni</p>
    </div>
  </div>
</section>
