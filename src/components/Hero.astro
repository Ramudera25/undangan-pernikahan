---
import { couple } from '../data/wedding';
import Gunungan from './ornaments/Gunungan.astro';
import SulurDivider from './ornaments/SulurDivider.astro';

const makeUrl = (p: string) => `${import.meta.env.BASE_URL}/${p}`.replace(/(?<!:)\/\/+/g, '/');
const { groom, bride } = couple;

const person = [
  { ...groom, from: 'right' as const, delay: 120 },
  { ...bride, from: 'left' as const, delay: 120 },
];
---

<section id="mempelai" class="text-center py-16 px-4 max-w-2xl mx-auto relative scroll-mt-24">
  <p class="text-[10px] text-wedding-600 tracking-[0.25em] uppercase font-semibold" data-reveal>
    Mempelai
  </p>
  <h2 class="font-serif text-3xl sm:text-4xl text-ink mt-1 mb-3" data-reveal data-reveal-delay="80">
    Kedua Mempelai
  </h2>
  <p class="text-sm text-ink-soft max-w-sm mx-auto leading-relaxed mb-4" data-reveal data-reveal-delay="160">
    Maha Suci Allah yang telah menyatukan kami dalam ikatan suci pernikahan.
  </p>
  <SulurDivider class="w-48 h-6 mx-auto text-wedding-400 mb-12" data-reveal data-reveal-delay="200" />

  <div class="space-y-10">
    {person.map((p, i) => (
      <div
        class="surface p-8 rounded-3xl backdrop-blur-md hover:border-wedding-400 hover:-translate-y-1 transition-all duration-300 relative overflow-hidden"
        data-reveal
        data-reveal-delay={String(i === 0 ? 200 : 320)}
      >
        <Gunungan class="absolute -top-2 left-1/2 -translate-x-1/2 w-24 h-32 text-wedding-200/70 pointer-events-none" />

        {/* Foto: mempelai pria masuk dari kanan, mempelai wanita dari kiri */}
        <div class="photo-frame relative w-32 h-32 mx-auto mb-5" data-reveal data-reveal-from={p.from} data-reveal-delay={String(p.delay)}>
          <img
            src={makeUrl(p.photo)}
            alt={`${p.fullName} — ${p.nickname}`}
            width="1254"
            height="1254"
            class="w-full h-full object-cover shadow-inner"
            loading="lazy"
          />
        </div>

        <p class="font-script text-4xl text-wedding-600 leading-none">{p.nickname}</p>
        <h3 class="font-serif text-xl sm:text-2xl font-semibold text-ink mt-1">{p.fullName}</h3>
        <p class="text-sm text-ink-soft mt-3 leading-relaxed">
          {p.relation}<br />
          {p.father}<br />
          &amp; {p.mother}
        </p>
      </div>
    ))}
  </div>

  <div class="flex items-center justify-center gap-4 mt-10" data-reveal data-reveal-delay="380">
    <span class="w-16 h-px bg-gradient-to-r from-transparent to-wedding-300"></span>
    <span class="font-script text-4xl text-wedding-500">&amp;</span>
    <span class="w-16 h-px bg-gradient-to-l from-transparent to-wedding-300"></span>
  </div>
</section>
