---
/* Konfeti emas ringan (±90 baris): canvas fixed, dipicu via window.fireGoldConfetti(). */
---

<canvas id="gold-confetti-canvas" aria-hidden="true"></canvas>

<script>
  declare global {
    interface Window {
      fireGoldConfetti?: () => void;
    }
  }

  type Particle = {
    x: number; y: number; vx: number; vy: number;
    size: number; rot: number; vr: number; color: string;
    life: number; decay: number;
  };

  (function () {
    var canvas = document.getElementById('gold-confetti-canvas') as HTMLCanvasElement | null;
    if (!canvas || !window.requestAnimationFrame) return;
    var ctx = canvas.getContext('2d');
    if (!ctx) return;
    var c2d = ctx as CanvasRenderingContext2D;
    var cvs = canvas as HTMLCanvasElement;

    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var COLORS = ['#c9a24b', '#e8cf8f', '#f6ecd4', '#d4af37', '#8fb6ce'];
    var particles: Particle[] = [];
    var rafId = 0;

    function resize() {
      var dpr = window.devicePixelRatio || 1;
      cvs.width = Math.floor(window.innerWidth * dpr);
      cvs.height = Math.floor(window.innerHeight * dpr);
      c2d.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function burst() {
      if (reduceMotion) return;
      resize();
      var w = window.innerWidth;
      var count = Math.min(140, Math.floor(w / 4));
      for (var i = 0; i < count; i++) {
        particles.push({
          x: w / 2 + (Math.random() - 0.5) * w * 0.5,
          y: window.innerHeight * 0.35,
          vx: (Math.random() - 0.5) * 9,
          vy: -Math.random() * 9 - 3,
          size: 4 + Math.random() * 6,
          rot: Math.random() * Math.PI * 2,
          vr: (Math.random() - 0.5) * 0.25,
          color: COLORS[(Math.random() * COLORS.length) | 0],
          life: 1,
          decay: 0.004 + Math.random() * 0.006,
        });
      }
      if (!rafId) tick();
    }

    function tick() {
      c2d.clearRect(0, 0, window.innerWidth, window.innerHeight);
      particles = particles.filter(function (p) {
        return p.life > 0 && p.y < window.innerHeight + 30;
      });
      for (var i = 0; i < particles.length; i++) {
        var p = particles[i];
        p.vy += 0.22; // gravitasi
        p.vx *= 0.99;
        p.x += p.vx;
        p.y += p.vy;
        p.rot += p.vr;
        p.life -= p.decay;
        c2d.save();
        c2d.globalAlpha = Math.max(0, Math.min(1, p.life * 1.4));
        c2d.translate(p.x, p.y);
        c2d.rotate(p.rot);
        c2d.fillStyle = p.color;
        // Keping persegi kecil + lingkaran, selang-seling.
        if (i % 3 === 0) {
          c2d.beginPath();
          c2d.arc(0, 0, p.size / 2.4, 0, Math.PI * 2);
          c2d.fill();
        } else {
          c2d.fillRect(-p.size / 2, -p.size / 3, p.size, p.size / 1.5);
        }
        c2d.restore();
      }
      if (particles.length) {
        rafId = requestAnimationFrame(tick);
      } else {
        rafId = 0;
        c2d.clearRect(0, 0, window.innerWidth, window.innerHeight);
      }
    }

    window.addEventListener('resize', function () {
      if (particles.length) resize();
    });
    window.fireGoldConfetti = burst;
  })();
</script>
