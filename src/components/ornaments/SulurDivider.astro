---
/**
 * Pembatas sulur: garis melengkung ke kiri dan kanan dengan motif
 * gunungan kecil di tengah. Warna mengikuti `currentColor`.
 */
const { class: className = '', ...rest } = Astro.props;
---

<svg viewBox="0 0 240 30" fill="none" stroke="currentColor" class={className} aria-hidden="true" {...rest}>
  <g stroke-width="1">
    <path
      stroke-linecap="round"
      d="M110 15c-13 0-18-10-33-8-14 2-19 12-34 10-13-2-16-9-29-7"
    ></path>
    <ellipse cx="77" cy="7" rx="4.5" ry="2.6" transform="rotate(-24 77 7)"></ellipse>
    <ellipse cx="43" cy="17" rx="4.5" ry="2.6" transform="rotate(14 43 17)"></ellipse>
    <circle cx="14" cy="10" r="1.8"></circle>
  </g>

  <!-- Motif gunungan kecil di tengah -->
  <path stroke-linejoin="round" d="M120 4c4 6 8 10 8 15s-4 8-8 8-8-3-8-8 4-9 8-15Z"></path>
  <circle cx="120" cy="15" r="1.6"></circle>

  <!-- Cermin kanan -->
  <g stroke-width="1" transform="translate(240 0) scale(-1 1)">
    <path
      stroke-linecap="round"
      d="M110 15c-13 0-18-10-33-8-14 2-19 12-34 10-13-2-16-9-29-7"
    ></path>
    <ellipse cx="77" cy="7" rx="4.5" ry="2.6" transform="rotate(-24 77 7)"></ellipse>
    <ellipse cx="43" cy="17" rx="4.5" ry="2.6" transform="rotate(14 43 17)"></ellipse>
    <circle cx="14" cy="10" r="1.8"></circle>
  </g>
</svg>
