  <path stroke-linecap="round" d="M9 34c0-14 11-25 25-25"></path>
  <path stroke-linecap="round" d="M34 9c7 0 11 5 8 10-2.5 4-8 3-8-2"></path>
  <path stroke-linecap="round" d="M9 34c0 7 5 11 10 8 4-2.5 3-8-2-8"></path>
  <circle cx="24" cy="24" r="1.6"></circle>
</svg>
