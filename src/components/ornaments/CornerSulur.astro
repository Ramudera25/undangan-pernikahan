---
/**
 * Sulur sudut untuk membingkai kartu/cover. Digambar di sudut kiri-atas;
 * putar/balik dengan class Tailwind (mis. `-scale-x-100`) untuk sudut lain.
 */
const { class: className = '', ...rest } = Astro.props;
---

<svg viewBox="0 0 64 64" fill="none" stroke="currentColor" class={className} aria-hidden="true" {...rest}>
