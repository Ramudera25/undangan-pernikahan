---
import { guestInfo } from '../data/wedding';
import SulurDivider from './ornaments/SulurDivider.astro';
import BungaHias from './ornaments/BungaHias.astro';
import ShareButtons from './ShareButtons.astro';
---

<section id="info-tamu" class="py-16 px-4 text-center max-w-4xl mx-auto scroll-mt-24">
  <p class="text-[10px] text-wedding-600 tracking-[0.25em] uppercase font-semibold" data-reveal>
    Panduan Kehadiran
  </p>
  <h2 class="font-serif text-3xl sm:text-4xl text-ink my-2" data-reveal data-reveal-delay="80">
    Info <span class="gold-text">Tamu</span>
  </h2>
  <p class="text-sm text-ink-soft max-w-md mx-auto leading-relaxed mt-3" data-reveal data-reveal-delay="100">
    Kehadiran Bapak/Ibu/Saudara/i adalah hadiah terindah bagi kami.
    Berikut panduan kecil agar hari bahagia ini terasa nyaman untuk kita semua.
  </p>
  <SulurDivider class="w-48 h-6 mx-auto text-gold mt-4 mb-8" data-reveal data-reveal-delay="120" />
  <BungaHias class="w-24 h-11 mx-auto text-wedding-400/70 -mt-5 mb-8" data-reveal data-reveal-delay="160" />

  <div class="grid gap-5 md:grid-cols-3 text-center">
    <!-- Dress code -->
    <div class="surface rounded-2xl p-6 flex flex-col items-center" data-reveal data-reveal-delay="140">
      <div class="w-11 h-11 rounded-full bg-wedding-200 flex items-center justify-center mb-4">
        <svg class="w-5 h-5 text-wedding-600" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 3L4 7l2.5 3L4 21h16l-2.5-11L20 7l-5-4a3 3 0 01-6 0z" />
        </svg>
      </div>
      <h3 class="font-serif text-lg text-ink mb-2">{guestInfo.dressCode.title}</h3>
      <p class="text-sm text-ink-soft leading-relaxed">{guestInfo.dressCode.text}</p>
    </div>

    <!-- Rundown -->
    <div class="surface rounded-2xl p-6 flex flex-col items-center" data-reveal data-reveal-delay="220">
      <div class="w-11 h-11 rounded-full bg-wedding-200 flex items-center justify-center mb-4">
        <svg class="w-5 h-5 text-wedding-600" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="8.5" />
          <path stroke-linecap="round" d="M12 7.5V12l3 2" />
        </svg>
      </div>
      <h3 class="font-serif text-lg text-ink mb-3">{guestInfo.rundown.title}</h3>
      <ul class="space-y-3 w-full">
        {guestInfo.rundown.items.map((item) => (
          <li class="flex flex-col items-center gap-1">
            <span class="inline-block w-2 h-2 rounded-full bg-gold"></span>
            <p class="text-[13px] font-semibold text-ink">{item.label}</p>
            <p class="text-xs text-ink-soft">{item.time}</p>
          </li>
        ))}
      </ul>
      <p class="text-xs text-ink-soft/80 italic mt-4 leading-relaxed">
        Catat waktunya — jangan sampai terlewat momen bahagianya!
      </p>
    </div>

    <!-- Denah & parkir -->
    <div class="surface rounded-2xl p-6 flex flex-col items-center" data-reveal data-reveal-delay="300">
      <div class="w-11 h-11 rounded-full bg-wedding-200 flex items-center justify-center mb-4">
        <svg class="w-5 h-5 text-wedding-600" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 20l-5.5-2.5v-13L9 7l6-2.5L20.5 7v13L15 17.5 9 20zm0 0v-13m6 10.5v-13" />
        </svg>
      </div>
      <h3 class="font-serif text-lg text-ink mb-2">{guestInfo.parking.title}</h3>
      <p class="text-sm text-ink-soft leading-relaxed">{guestInfo.parking.text}</p>
    </div>
  </div>

  <div class="mt-10" data-reveal>
    <ShareButtons />
  </div>
</section>
