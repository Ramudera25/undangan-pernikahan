---
const makeUrl = (p: string) => `${import.meta.env.BASE_URL}/${p}`.replace(/(?<!:)\/\/+/g, '/');
const photos = [
  makeUrl('gallery-1.jpg'),
  makeUrl('gallery-2.jpg'),
  makeUrl('gallery-3.jpg')
];
---
<section class="py-16 px-4 text-center max-w-3xl mx-auto">
  <p class="text-[10px] text-[#C5A880] tracking-[0.25em] uppercase font-semibold" data-reveal>MOMEN KAMI</p>
  <h2 class="font-serif text-3xl sm:text-4xl text-[#2B2625] mt-1 mb-8" data-reveal data-reveal-delay="80">Galeri Bahagia</h2>

  <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
    {photos.map((url, index) => (
      <div class="overflow-hidden rounded-2xl border border-[#C5A880]/20 group shadow-sm" data-reveal data-reveal-delay={String(index * 100)}>
        <img 
          src={url} 
          alt={`Gallery ${index + 1}`} 
          class="w-full h-44 object-cover group-hover:scale-110 transition-transform duration-500 ease-out"
          loading="lazy"
        />
      </div>
    ))}
  </div>
</section>
