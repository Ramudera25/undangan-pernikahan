<section class="bg-gray-50 py-12 px-4 text-center">
  <p class="text-xs text-[#C5A880] tracking-widest uppercase">TANDA KASIH</p>
  <h2 class="font-serif text-3xl text-[#2B2625] my-2">Amplop Digital</h2>
  <p class="text-xs text-gray-600 max-w-sm mx-auto mb-6">Doa restu Anda merupakan hadiah terindah. Bagi yang ingin memberikan tanda kasih, dapat melalui rekening berikut:</p>

  <div class="bg-white p-6 rounded-2xl border border-gray-200 max-w-xs mx-auto shadow-sm">
    <p class="font-bold text-sm text-gray-700">BANK BCA</p>
    <p id="rek-num" class="text-lg font-mono font-bold text-[#2B2625] my-2">8830123456</p>
    <p class="text-xs text-gray-500">a.n. Bayu Setiawan</p>
    <button id="btn-copy" class="mt-4 px-4 py-2 bg-[#2B2625] text-[#EFE7DA] text-xs rounded-lg">SALIN NO. REKENING</button>
  </div>
</section>

<script>
  document.getElementById('btn-copy')?.addEventListener('click', () => {
    const rek = document.getElementById('rek-num')?.textContent;
    if (rek) {
      navigator.clipboard.writeText(rek);
      alert('Nomor rekening berhasil disalin!');
    }
  });
</script>