---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Halaman Tidak Ditemukan">
  <div class="min-h-screen flex flex-col items-center justify-center text-center p-4">
    <h1 class="text-4xl font-serif text-[#2B2625]">404</h1>
    <p class="text-xs text-gray-500 mt-2">Halaman yang Anda cari tidak ditemukan.</p>
    <a href={import.meta.env.BASE_URL} class="mt-4 px-4 py-2 bg-[#C5A880] text-[#2B2625] text-xs rounded-full">Kembali ke Undangan</a>
  </div>
</Layout>