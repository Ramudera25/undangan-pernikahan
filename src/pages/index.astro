---
import Layout from '../layouts/Layout.astro';
import Cover from '../components/Cover.astro';
import Hero from '../components/Hero.astro';
import LoveStory from '../components/LoveStory.astro';
import EventDetail from '../components/EventDetail.astro';
import Gallery from '../components/Gallery.astro';
import GuestBook from '../components/GuestBook';
import GiftInfo from '../components/GiftInfo.astro';
import MusicPlayer from '../components/MusicPlayer';
import PetalsAnimation from '../components/PetalsAnimation.astro';
import RevealOnScroll from '../components/RevealOnScroll.astro';
---

<Layout title="Undangan Pernikahan Bayu & Winda">
  <RevealOnScroll />
  <PetalsAnimation />
  <Cover />
  <main class="w-full overflow-hidden">
    <Hero />
    <LoveStory />
    <EventDetail />
    <Gallery />
    <GuestBook client:visible />
    <GiftInfo />
  </main>
  <MusicPlayer client:load />
</Layout>
