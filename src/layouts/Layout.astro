---
import '../styles/theme.css';
import Preloader from '../components/Preloader.astro';
import { couple, events, seo } from '../data/wedding';

interface Props {
  title: string;
  description?: string;
}
const { title, description = seo.description } = Astro.props;

const makeUrl = (p: string) => `${import.meta.env.BASE_URL}/${p}`.replace(/(?<!:)\/\/+/g, '/');
const site = import.meta.env.SITE;
const absolute = (p: string) => `${site}${makeUrl(p)}`.replace(/(?<!:)\/\/+/g, '/');
const coverImage = absolute(seo.coverImage);
/* Gambar pratinjau saat link dibagikan (1200x630, dibuat saat build/deploy). */
const ogImage = absolute('og-image.jpg');

const scheduled = events.filter((e) => e.startISO !== null);
const firstStart = scheduled[0]?.startISO ?? null;
const lastEnd = scheduled[scheduled.length - 1]?.endISO ?? null;

const weddingEvent = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: `Pernikahan ${couple.shortName}`,
  description: `Akad Nikah dan Resepsi pernikahan ${couple.groom.fullName} & ${couple.bride.fullName}.`,
  ...(firstStart ? { startDate: firstStart } : {}),
  ...(lastEnd ? { endDate: lastEnd } : {}),
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: events.map((e) => ({
    '@type': 'Place',
    name: e.venue,
    address: e.address,
  })),
  image: coverImage,
  organizer: [
    { '@type': 'Person', name: couple.groom.fullName },
    { '@type': 'Person', name: couple.bride.fullName },
  ],
};

const tabTitle = `${couple.shortName} \u00b7 `;
---

<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#F5FAFE" />
    <meta name="description" content={description} />
    <link
      rel="icon"
      type="image/svg+xml"
      href={`data:image/svg+xml,${encodeURIComponent(`<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='22' fill='#243E50'/><path d='M50 14c7 10 20 20 23 40 2 17-7 30-23 38-16-8-25-21-23-38 3-20 16-30 23-40Z' fill='none' stroke='#8FB6CE' stroke-width='3'/><text x='50' y='63' font-size='30' font-family='Georgia,serif' fill='#DCEEF8' text-anchor='middle'>${couple.initials}</text></svg>`)}`}
    />
    <link rel="canonical" href={absolute('')} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..700;1,400..700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Sacramento&family=Great+Vibes&display=swap"
      rel="stylesheet"
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={couple.shortName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`Undangan Pernikahan ${couple.shortName}`} />
    <meta property="og:url" content={absolute('')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(weddingEvent)}></script>

    <!-- Terapkan tema tersimpan sedini mungkin agar tidak ada kedip terang. -->
    <script is:inline>
      (function () {
        try {
          var keys = Object.keys(localStorage);
          for (var i = 0; i < keys.length; i++) {
            if (/-theme$/.test(keys[i]) && localStorage.getItem(keys[i]) === 'dark') {
              document.documentElement.classList.add('dark');
              break;
            }
          }
        } catch (e) {}
      })();
    </script>

    <title>{title}</title>

    <script is:inline define:vars={{ tabTitle }}>
      (function () {
        var params = new URLSearchParams(window.location.search);
        var name = params.get('to') || params.get('nama') || params.get('kpd') || params.get('untuk');
        if (name) {
          try {
            name = decodeURIComponent(name).replace(/\+/g, ' ').trim();
          } catch (e) {}
          name = String(name).replace(/<[^>]*>/g, '').slice(0, 60);
          if (name) {
            document.title = tabTitle + name;
          }
        }
      })();
    </script>
  </head>
  <body
    class="bg-wedding-50 text-ink font-sans antialiased selection:bg-wedding-300 selection:text-ink relative"
  >
    <Preloader />
    <!-- Progress bar emas: terisi sesuai progres scroll -->
    <div
      id="scroll-progress"
      aria-hidden="true"
      class="fixed top-0 left-0 h-[3px] w-0 z-[70] bg-gradient-to-r from-[#b8860b] via-[#f4dc8a] to-[#d4af37] pointer-events-none"
    ></div>
    <!-- Tekstur motif kawung beropasitas rendah -->
    <div class="orn-kawung fixed inset-0 pointer-events-none opacity-[0.35] z-0"></div>

    <!-- Cahaya ambient biru muda -->
    <div
      class="fixed top-[-12%] left-[-12%] w-[55vw] h-[55vw] bg-wedding-200/60 rounded-full blur-[130px] pointer-events-none z-0"
    ></div>
    <div
      class="fixed bottom-[-12%] right-[-12%] w-[55vw] h-[55vw] bg-wedding-300/40 rounded-full blur-[130px] pointer-events-none z-0"
    ></div>

    <div class="relative z-10">
      <slot />
    </div>

    <!-- Perbarui progress bar emas mengikuti posisi scroll -->
    <script is:inline>
      (function () {
        var bar = document.getElementById('scroll-progress');
        if (!bar) return;
        var ticking = false;
        function update() {
          ticking = false;
          var h = document.documentElement;
          var max = h.scrollHeight - h.clientHeight;
          var p = max > 0 ? h.scrollTop / max : 0;
          bar.style.width = (p * 100).toFixed(2) + '%';
        }
        window.addEventListener(
          'scroll',
          function () {
            if (!ticking) {
              ticking = true;
              requestAnimationFrame(update);
            }
          },
          { passive: true },
        );
        window.addEventListener('resize', update);
        update();
      })();
    </script>
  </body>
</html>

<style is:global>
  body {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 15px;
  }
  h1,
  h2,
  h3,
  .font-serif {
    font-family: 'Playfair Display', serif;
  }
  .font-script {
    font-family: 'Great Vibes', cursive;
  }
</style>

